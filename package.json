{
  "name": "fanta-halloween-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Apresentação interativa (conceitual, não oficial) da coleção Fanta Halloween 2026 com os vídeos v2-tampa-fixa.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "verify:layout": "node scripts/verify/responsive.mjs",
    "verify:interact": "node scripts/verify/interact.mjs && node scripts/verify/compare.mjs",
    "verify:resilience": "node scripts/verify/resilience.mjs",
    "verify:resize": "node scripts/verify/resize.mjs",
    "verify": "npm run verify:layout && npm run verify:interact && npm run verify:resilience && npm run verify:resize"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
